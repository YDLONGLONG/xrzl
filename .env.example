# QQ互联配置
# 申请地址：https://connect.qq.com/
# 1. 注册QQ互联开发者账号
# 2. 创建网站应用，获取 APP ID 和 APP Key
# 3. 配置回调地址为：http://localhost:3000/api/qq/callback

QQ_APP_ID=你的APP_ID
QQ_APP_KEY=你的APP_KEY
QQ_REDIRECT_URI=http://localhost:3000/api/qq/callback

# 微信开放平台配置
# 申请地址：https://open.weixin.qq.com/
# 1. 注册微信开放平台账号
# 2. 创建网站应用，获取 AppID 和 AppSecret
# 3. 配置授权回调域（域名，不带 http://）和回调地址为：http://localhost:3000/api/wechat/callback

WX_APP_ID=你的微信AppID
WX_APP_SECRET=你的微信AppSecret
WX_REDIRECT_URI=http://localhost:3000/api/wechat/callback
